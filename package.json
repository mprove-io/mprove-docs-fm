{
  "name": "mprove-docs-fm",
  "version": "12.0.19",
  "private": true,
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "build": "next build",
    "docs:ai": "node scripts/generate-ai-docs-page.cjs",
    "clean:mcp": "rm -rf public/mcp.json",
    "clean:openapi": "rm -rf public/openapi.json public/openapi-paths",
    "fetch:mcp": "pnpm run clean:mcp && node scripts/fetch-mcp.cjs",
    "fetch:openapi": "pnpm run clean:openapi && node scripts/fetch-openapi.cjs",
    "fetch:backend": "pnpm run fetch:mcp && pnpm run fetch:openapi",
    "dev": "pnpm run docs:ai && next dev",
    "next-start": "next start",
    "types:check": "fumadocs-mdx && next typegen && tsc --noEmit",
    "postinstall": "fumadocs-mdx",
    "check-links": "bun scripts/lint.ts",
    "lint": "biome check",
    "format": "biome format --write",
    "clean:node_modules": "rm -rf ./node_modules/* && rm -rf ./node_modules/.bin/*&& rm -rf ./node_modules/.cache/* && rm -rf ./node_modules/.pnpm/* && rm -rf ./node_modules/.tmp/* && rm -rf ./node_modules/.modules.yaml && rm -rf ./node_modules/.pnpm-workspace-state-v1.json"
  },
  "dependencies": {
    "@radix-ui/react-tabs": "1.1.13",
    "class-variance-authority": "0.7.1",
    "fumadocs-core": "16.7.14",
    "fumadocs-openapi": "10.6.8",
    "fumadocs-mdx": "14.2.13",
    "fumadocs-ui": "16.7.14",
    "lucide-react": "0.561.0",
    "next": "16.2.3",
    "next-validate-link": "1.6.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "shiki": "3.20.0",
    "tailwind-merge": "3.4.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.3.10",
    "@tailwindcss/postcss": "4.1.18",
    "@types/bun": "1.3.5",
    "@types/mdx": "2.0.13",
    "@types/node": "24.10.4",
    "@types/react": "19.2.7",
    "@types/react-dom": "19.2.3",
    "postcss": "8.5.6",
    "tailwindcss": "4.1.18",
    "typescript": "5.9.3"
  }
}
